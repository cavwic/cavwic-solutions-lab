{
  "name": "cavwic-solutions-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 43202",
    "dev:start": "astro dev --port 43202 --host 127.0.0.1 --background",
    "dev:stop": "astro dev stop",
    "dev:status": "astro dev status",
    "dev:logs": "astro dev logs",
    "review": "node scripts/serve-dist.mjs --port 43202",
    "dev:test": "node scripts/serve-dist.mjs --port 14332",
    "package:skills": "node scripts/package-skills.mjs",
    "build": "npm run package:skills && astro build",
    "build:review": "astro build --mode review",
    "check": "astro check",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "verify": "npm run check && npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.2",
    "@lucide/astro": "^1.31.0",
    "astro": "^7.2.1",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.10.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.1",
    "pdfjs-dist": "^6.2.108",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@playwright/test": "^1.58.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
