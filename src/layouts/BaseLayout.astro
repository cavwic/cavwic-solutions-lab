---
import { ClipboardCheck, FileOutput, FileSearch, House, PackageCheck } from "@lucide/astro";
import "../styles/global.css";
const { title, titleZh = title, titleEn = title, current } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (path: string) => `${base}${path}`;
---
<!doctype html>
<html lang="zh-CN" data-locale="zh">
  <head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="description" content="Local-first presales, tender requirement, technical bid, and handover workbench."/>
    <meta name="color-scheme" content="light dark"/>
    <title>{title}</title>
    <script is:inline define:vars={{ titleZh, titleEn }}>
      const saved = localStorage.getItem("cavwic-lab-theme");
      document.documentElement.dataset.theme = saved === "light" || saved === "dark" ? saved : (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      const savedLocale = localStorage.getItem("cavwic-lab-locale");
      const initialLocale = savedLocale === "zh" || savedLocale === "en" ? savedLocale : (navigator.language.toLowerCase().startsWith("zh") ? "zh" : "en");
      const applyLocale = (locale) => {
        document.documentElement.dataset.locale = locale;
        document.documentElement.lang = locale === "zh" ? "zh-CN" : "en";
        document.title = locale === "zh" ? titleZh : titleEn;
      };
      applyLocale(initialLocale);
      window.addEventListener("cavwic-locale-change", (event) => applyLocale(event.detail));
    </script>
  </head>
  <body>
    <header class="lab-header">
      <a class="lab-brand" href={href("/")}><span>C</span><strong>CAVWIC SOLUTIONS LAB</strong></a>
      <nav aria-label="解决方案工作台 / Solution workbenches">
        <a class:list={{ active: current === "home" }} href={href("/")} aria-label="工作台 / Workbench"><House size={18}/><span data-i18n="zh">工作台</span><span data-i18n="en">Workbench</span></a>
        <a class:list={{ active: current === "requirements" }} href={href("/requirements")} aria-label="招标要求 / Tender requirements"><FileSearch size={18}/><span data-i18n="zh">招标要求</span><span data-i18n="en">Requirements</span></a>
        <a class:list={{ active: current === "bid" }} href={href("/bid-package")} aria-label="技术标组包 / Technical bid package"><PackageCheck size={18}/><span data-i18n="zh">技术标组包</span><span data-i18n="en">Bid package</span></a>
        <a class:list={{ active: current === "handover" }} href={href("/handover")} aria-label="中标交底 / Award handover"><ClipboardCheck size={18}/><span data-i18n="zh">中标交底</span><span data-i18n="en">Handover</span></a>
        <a class:list={{ active: current === "outputs" }} href={href("/outputs")} aria-label="输出与 Skills / Outputs and Skills"><FileOutput size={18}/><span data-i18n="zh">输出与 Skills</span><span data-i18n="en">Outputs</span></a>
      </nav>
    </header>
    <main><slot/></main>
  </body>
</html>
