---
import { FileSearch, House, PackageCheck } from "@lucide/astro";
import "../styles/global.css";
const { title, current } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (path: string) => `${base}${path}`;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="description" content="Local-first presales, tender requirement, technical bid, and handover workbench."/>
    <meta name="color-scheme" content="light dark"/>
    <title>{title}</title>
    <script is:inline>
      const saved = localStorage.getItem("cavwic-lab-theme");
      document.documentElement.dataset.theme = saved === "light" || saved === "dark" ? saved : (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
    </script>
  </head>
  <body>
    <header class="lab-header">
      <a class="lab-brand" href={href("/")}><span>C</span><strong>CAVWIC SOLUTIONS LAB</strong></a>
      <nav aria-label="Workbenches">
        <a class:list={{ active: current === "home" }} href={href("/")} title="Solution workbench"><House size={18}/><span>Workbench</span></a>
        <a class:list={{ active: current === "requirements" }} href={href("/requirements")} title="Tender requirements"><FileSearch size={18}/><span>Requirements</span></a>
        <a class:list={{ active: current === "bid" }} href={href("/bid-package")} title="Technical bid package"><PackageCheck size={18}/><span>Bid package</span></a>
      </nav>
    </header>
    <main><slot/></main>
  </body>
</html>
